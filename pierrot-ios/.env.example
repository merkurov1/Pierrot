# Public mobile client configuration.
#
# Only EXPO_PUBLIC_* values are bundled into the app. Never place the Supabase
# service-role key, Gemini key, DeepSeek key or any server secret here.

EXPO_PUBLIC_API_URL=https://www.merkurov.love
EXPO_PUBLIC_SITE_URL=https://www.merkurov.love

# Public Supabase project + publishable anon key. Required only for sign-in
# and owner-only Brain. Chat and Flow work without them.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
